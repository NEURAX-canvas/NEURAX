# Build-time settings for the desktop bundle (`npm run build:desktop`).
#
# The desktop application is single-user and local-first: the compiler runs
# inside the app, on a loopback port, and there is no server holding anyone's
# projects. So there is no account to sign in to, and the UI uses the local
# profile it stores on the machine instead.
VITE_SUPABASE_DISABLED=true

# VITE_NEURAX_API_URL is deliberately not set. The desktop host assigns its API
# port at launch and injects the address into the page, so there is nothing to
# bake in; see `src/services/desktopRuntime.ts`. Setting it to an empty string
# would be worse than leaving it out — `??` treats "" as a value, so the
# built-in fallback would never apply if the injection ever failed.

# The AI agent is a separate Python service that the user runs themselves. If
# it is running, the desktop app will find it at this address.
VITE_AGENT_BASE_URL=http://127.0.0.1:8099
