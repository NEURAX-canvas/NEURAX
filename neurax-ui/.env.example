# ======================
# NEURAX - Frontend (neurax-ui)
# ======================

# Backend base URL (must match where neurax-service is reachable)
VITE_NEURAX_API_URL=http://localhost:9098

VITE_AGENT_BASE_URL=http://127.0.0.1:8099

# There's nothing to configure for accounts: NEURAX's account is a local
# profile, created automatically on first launch and kept in this browser's
# storage — no identity server, no project to set up. See
# src/contexts/AuthContext.tsx.
